lệnh đưa file front_end lên github
git init
git branch -M main
git remote add origin https://github.com/ikuizuki/fanta-world.git
git add . && git commit -m "update" && git push

lệnh đưa file back_end lên github
git init
git branch -M main
git remote add origin https://github.com/ikuizuki/fanta-world-backend.git
git add . && git commit -m "update" && git push

lệnh tạo repo mới trên git
echo "# fanta-world-game" >> README.md
git init
git add README.md
git commit -m "first commit"
git branch -M main
git remote add origin https://github.com/ikuizuki/fanta-world-game.git
git push -u origin main

đẩy kho lưu trữ lên git
git remote add origin https://github.com/ikuizuki/fanta-world-game.git
git branch -M main
git push -u origin main

link fanta-world-game https://github.com/ikuizuki/fanta-world-game.git
git init
git branch -M main
git remote add origin https://github.com/ikuizuki/fanta-world-game.git
git add . && git commit -m "update" && git push
